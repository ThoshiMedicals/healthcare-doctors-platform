{
  "version": "1.0",
  "runtimeSource": "Current production HTML and updates-data.js remain authoritative until CMS migration.",
  "collections": {
    "practitioners": {
      "path": "doctors/",
      "fields": [
        "name",
        "role",
        "biography",
        "qualifications",
        "languages",
        "areasOfCare",
        "professionalInterests",
        "relatedServices",
        "bookingUrl",
        "portrait",
        "status",
        "updatedAt"
      ]
    },
    "services": {
      "path": "services/",
      "fields": [
        "title",
        "summary",
        "patientEducation",
        "whyItMatters",
        "howWeHelp",
        "nextStep",
        "faqs",
        "relatedPractitioners",
        "relatedServices",
        "clinicalReviewStatus",
        "reviewedBy",
        "lastReviewed",
        "status",
        "updatedAt",
        "nextReview",
        "contentOwner",
        "approvalReference"
      ]
    },
    "practiceInformation": {
      "path": "/",
      "fields": [
        "title",
        "summary",
        "sections",
        "relatedPages",
        "clinicalReviewStatus",
        "reviewedBy",
        "lastReviewed",
        "status",
        "updatedAt",
        "nextReview",
        "contentOwner",
        "approvalReference"
      ]
    },
    "updates": {
      "path": "updates/",
      "categories": [
        "Practice Updates",
        "Patient Education",
        "Service Information",
        "Clinical Governance",
        "Community Health Information"
      ],
      "fields": [
        "id",
        "title",
        "category",
        "published",
        "summary",
        "image",
        "imageAlt",
        "author",
        "sections",
        "status",
        "reviewStatus",
        "reviewedBy",
        "lastReviewed",
        "updatedAt",
        "audience"
      ]
    },
    "faqs": {
      "path": "faqs.html",
      "fields": [
        "category",
        "question",
        "answer",
        "relatedPage",
        "status",
        "updatedAt"
      ]
    },
    "siteSettings": {
      "fields": [
        "practiceName",
        "contact",
        "openingHours",
        "address",
        "afterHours",
        "booking",
        "network",
        "seoDefaults"
      ]
    },
    "media": {
      "path": "assets/",
      "fields": [
        "filename",
        "assetType",
        "altText",
        "subject",
        "source",
        "authenticityStatus",
        "usage",
        "updatedAt"
      ]
    },
    "googleBusinessProfile": {
      "runtime": false,
      "fields": [
        "name",
        "address",
        "phone",
        "website",
        "hours",
        "businessDescription",
        "categories",
        "services",
        "faqs",
        "updates",
        "photos",
        "verificationStatus"
      ]
    },
    "clinicalReview": {
      "runtime": "governance-published.js generated by cms/tools/build_clinical_governance.py",
      "editorialSource": "cms/governance-records.json eligibility + private approved review register",
      "fields": [
        "path",
        "collection",
        "reviewType",
        "status",
        "reviewedBy",
        "lastReviewed",
        "nextReview",
        "contentOwner",
        "approvedBy",
        "approvedAt",
        "approvalReference",
        "evidenceReference",
        "contentOwnerSubmittedBy",
        "contentOwnerSubmittedAt",
        "reviewerSignedBy",
        "reviewerSignedAt",
        "reviewedContentSha256"
      ],
      "publicationRule": "Content owner submission, appropriate reviewer sign-off, practice approval and actual next review due date required. Only the approved four public fields appear."
    },
    "knowledgeCentre": {
      "path": "knowledge/",
      "type": "Healthcare authority and patient education",
      "fields": [
        "title",
        "category",
        "summary",
        "educationalContent",
        "whenToSeekMedicalAdvice",
        "howGpCanHelp",
        "relatedServices",
        "relatedPractitioners",
        "faqs",
        "trustedSources",
        "bookingCta",
        "seo",
        "clinicalReviewStatus",
        "reviewedBy",
        "lastReviewed",
        "status",
        "updatedAt",
        "nextReview",
        "contentOwner",
        "approvalReference",
        "dueDate",
        "clinicalApproval",
        "publicationDate",
        "plannedPublicationDate",
        "nextReviewDate",
        "articlePath",
        "seoReviewComplete",
        "sourceVerificationComplete",
        "internalLinksVerified",
        "accessibilityReviewComplete"
      ]
    },
    "networkLocations": {
      "path": "medical-centre-network.html",
      "fields": [
        "clinicName",
        "suburb",
        "description",
        "website",
        "bookingUrl",
        "status",
        "updatedAt"
      ]
    },
    "knowledgeCentrePublishing": {
      "source": "cms/editorial-calendar.json",
      "privateOperations": "Private companion publishing dashboard; store completed register OUTSIDE website root",
      "cycle": "Recurring January-December",
      "fields": [
        "id",
        "year",
        "month",
        "theme",
        "primaryCategory",
        "contentOwner",
        "dueDate",
        "status",
        "clinicalApproval",
        "plannedPublicationDate",
        "publicationDate",
        "nextReviewDate",
        "articlePath",
        "sourceVerificationComplete",
        "seoReviewComplete",
        "accessibilityReviewComplete",
        "internalLinksVerified",
        "liveVerifiedBy",
        "liveVerifiedAt",
        "updatedAt",
        "history"
      ]
    }
  }
}
