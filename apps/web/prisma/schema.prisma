  status               GpStoryStatus     @default(invited)
  workflowVersion      String            @default("1.0.0") @map("workflow_version")
  interviewScheduledAt DateTime?         @map("interview_scheduled_at")
  interviewedAt        DateTime?         @map("interviewed_at")
  publishedAt          DateTime?         @map("published_at")
  withdrawnAt          DateTime?         @map("withdrawn_at")
  archivedAt           DateTime?         @map("archived_at")
  specialInterestLabel String?           @map("special_interest_label")
  honestyCueEnabled    Boolean           @default(true) @map("honesty_cue_enabled")
