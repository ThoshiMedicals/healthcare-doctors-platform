// Infrastructure schema for the clinic platform.
// The approved HTML package is not imported by this schema.
// Public page HTML is stored only after a later, explicit content migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClinicStatus {
  live
  external
  draft
}

enum MembershipRole {
  network_admin
  clinic_admin
  editor
  clinical_reviewer
  practice_approver
  publisher
  super_admin
  content_editor
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

enum PageTemplate {
  home
  section_hub
  service
  practitioner
  team_hub
  knowledge_topic
  knowledge_article
  update
  practice_page
  contact
  network
  not_found
}

enum ContentCollection {
  practitioner
  service
  practice_information
  update
  faq
  knowledge_topic
  knowledge_article
  network_location
  media
  navigation
}

enum PageStatus {
  draft
  in_review
  published
  archived
}

enum PublicationStatus {
  planned
  assigned
  drafting
  clinical_review
  approved
  scheduled
  published
  review_due
  on_hold
}

enum ReviewType {
  clinical
  operational
  institutional
}

enum ReviewStatus {
  draft
  under_review
  approved
  published
  review_due
}

enum UpdateCategory {
  practice_updates
  patient_education
  service_information
  clinical_governance
  community_health_information
}

enum VacancyStatus {
  now_hiring
  expression_of_interest
  future_opportunity
  closed
}

enum VacancyRoleCategory {
  general_practitioner
  gp_registrar
  practice_nurse
  enrolled_nurse
  reception
  practice_manager
  allied_health
  psychologist
  dietitian
  physiotherapist
  student_placement
  other
}

enum CareerApplicationStatus {
  new
  reviewing
  interview
  offer
  hired
  rejected
  closed
}

enum FormRequestStatus {
  new
  assigned
  in_progress
  waiting_for_patient
  completed
  closed
}

enum MediaAuthenticity {
  unverified
  verified
  legacy_production
}

model Network {
  id          String             @id @default(cuid())
  name        String
  positioning String             @db.Text
  clinics     Clinic[]
  locations   NetworkLocation[]
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@map("networks")
}

model Clinic {
  id               String             @id @default(cuid())
  networkId        String             @map("network_id")
  slug             String             @unique
  practiceName     String             @map("practice_name")
  legalName        String?            @map("legal_name")
  status           ClinicStatus       @default(draft)
  /** Optional per-clinic golden HTML corpus root. Null → GOLDEN_HTML_ROOT / old-html. */
  goldenHtmlRoot   String?            @map("golden_html_root")
  network          Network            @relation(fields: [networkId], references: [id], onDelete: Restrict)
  domains          ClinicDomain[]
  profile          ClinicProfile?
  openingHours     OpeningHours[]
  memberships      ClinicMembership[]
  pages            Page[]
  navigationItems  NavigationItem[]
  practitioners    Practitioner[]
  services         Service[]
  knowledgeTopics  KnowledgeTopic[]
  knowledgeArticles KnowledgeArticle[]
  practiceUpdates  PracticeUpdate[]
  faqs             Faq[]
  practicePages    PracticePage[]
  vacancies            Vacancy[]
  careerApplications   CareerApplication[]
  searchDemandSignals  SearchDemandSignal[]
  mediaAssets          MediaAsset[]
  editorialItems       EditorialItem[]
  searchDocuments      SearchDocument[]
  formRequests         FormRequest[]
  auditLogs            AuditLog[]
  clinicalReviews      ClinicalReview[]
  contentRevisions     ContentRevision[]
  attractionDocuments  AttractionDocument[]
  attractionAssets     AttractionAsset[]
  gpStories            GpStory[]
  gpEnquiries          GpEnquiry[]
  gpOnboardingCases    GpOnboardingCase[]
  gpDoctorReadiness    GpDoctorReadinessResult[]
  gpReadinessPackages  GpReadinessPackage[]
  gpDoctorProfileDrafts GpDoctorProfileDraft[]
  sessionMatchRuns     SessionCapacityMatchRun[]
  capacityWindows      CapacitySessionWindow[]
  gpFirst90Cases       GpFirst90SettlingCase[]
  attractionEvents     GpAttractionEvent[]
  attractionDailyRollups GpAttractionDailyRollup[]
  attractionPathRollups  GpAttractionPathRollup[]
  contentIntelSignals  ContentIntelligenceSignalDaily[]
  contentIntelRuns     ContentIntelligenceInsightRun[]
  knowledgeGraphSnaps  AttractionKnowledgeGraphSnapshot[]
  privateObjects       PrivateObject[]
  linkedLocations      NetworkLocation[]  @relation("LinkedClinic")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  @@index([networkId])
  @@map("clinics")
}

model ClinicDomain {
  id        String   @id @default(cuid())
  clinicId  String   @map("clinic_id")
  hostname  String   @unique
  isPrimary Boolean  @default(false) @map("is_primary")
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clinicId])
  @@map("clinic_domains")
}

model ClinicProfile {
  id                   String   @id @default(cuid())
  clinicId             String   @unique @map("clinic_id")
  phoneDisplay         String   @map("phone_display")
  phoneTel             String   @map("phone_tel")
  faxDisplay           String?  @map("fax_display")
  email                String
  streetAddress        String   @map("street_address")
  suburb               String
  state                String
  postcode             String
  country              String   @default("AU")
  localitiesServed     String[] @map("localities_served")
  afterHoursProvider   String?  @map("after_hours_provider")
  afterHoursPhone      String?  @map("after_hours_phone")
  afterHoursPagePath   String?  @map("after_hours_page_path")
  bookingPagePath      String?  @map("booking_page_path")
  hotdocUrl            String?  @map("hotdoc_url")
  billingPolicy        String?  @map("billing_policy") @db.Text
  agpalStatus          String?  @map("agpal_status")
  contentStatus        PublicationStatus @default(published) @map("content_status")
  publishedPayload     Json?    @map("published_payload")
  logoPath             String?  @map("logo_path")
  ogImagePath          String?  @map("og_image_path")
  seoTitleSuffix       String?  @map("seo_title_suffix")
  locale               String   @default("en-AU")
  canonicalBaseUrl     String   @map("canonical_base_url")
  clinic               Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("clinic_profiles")
}

model OpeningHours {
  id        String    @id @default(cuid())
  clinicId  String    @map("clinic_id")
  dayOfWeek DayOfWeek @map("day_of_week")
  opens     String
  closes    String
  clinic    Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, dayOfWeek])
  @@map("opening_hours")
}

model User {
  id            String             @id @default(cuid())
  name          String?
  username      String?            @unique
  email         String?            @unique
  emailVerified DateTime?          @map("email_verified")
  image         String?
  passwordHash  String?            @map("password_hash")
  disabledAt    DateTime?          @map("disabled_at")
  accounts      Account[]
  sessions      Session[]
  memberships          ClinicMembership[]
  revisions            PageRevision[]
  contentRevisions     ContentRevision[]
  attractionRevisions  AttractionRevision[]
  attractionApprovals  AttractionApprovalEvent[]
  attractionAssetReviews AttractionAssetReviewEvent[]
  gpStoryReviews       GpStoryReviewEvent[]
  gpStoriesCreated     GpStory[]            @relation("GpStoryCreator")
  gpOnboardingGates    GpOnboardingGateEvent[]
  gpEnquiryNotes       GpEnquiryNote[]
  gpEnquiryAudits      GpEnquiryStatusAudit[]
  gpDoctorProfileAudits GpDoctorProfileStatusAudit[]
  gpReadinessPackageNotes GpReadinessPackageNote[]
  gpReadinessPackageAudits GpReadinessPackageStatusAudit[]
  gpReadinessPackageTasksAssigned GpReadinessPackageTask[] @relation("GpReadinessPackageTaskAssignee")
  gpReadinessPackageTasksCreated  GpReadinessPackageTask[] @relation("GpReadinessPackageTaskCreator")
  auditLogs            AuditLog[]
  assignedApplications CareerApplication[] @relation("CareerApplicationAssignee")
  assignedFormRequests FormRequest[]       @relation("FormRequestAssignee")
  assignedGpEnquiries  GpEnquiry[]         @relation("GpEnquiryAssignee")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model LoginThrottle {
  id           String    @id @default(cuid())
  subject      String    @unique
  failures     Int       @default(0)
  lockedUntil  DateTime? @map("locked_until")
  lastFailedAt DateTime  @default(now()) @map("last_failed_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("login_throttles")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ClinicMembership {
  id        String         @id @default(cuid())
  userId    String         @map("user_id")
  clinicId  String         @map("clinic_id")
  role      MembershipRole
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic    Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([userId, clinicId])
  @@index([clinicId])
  @@map("clinic_memberships")
}

model Page {
  id                   String              @id @default(cuid())
  clinicId             String              @map("clinic_id")
  path                 String
  template             PageTemplate
  collection           ContentCollection?
  indexable            Boolean             @default(true)
  title                String
  description          String              @db.Text
  canonicalPath        String              @map("canonical_path")
  robots               String              @default("index,follow,max-image-preview:large")
  openGraph            Json?               @map("open_graph")
  breadcrumb           Json?
  status               PageStatus          @default(draft)
  publishedRevisionId  String?             @unique @map("published_revision_id")
  clinic               Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  publishedRevision    PageRevision?       @relation("PublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: SetNull)
  revisions            PageRevision[]      @relation("PageRevisions")
  navigationOwnership  NavigationOwnership?
  clinicalReview       ClinicalReview?
  searchDocument       SearchDocument?
  practitioner         Practitioner?
  service              Service?
  knowledgeTopic       KnowledgeTopic?
  knowledgeArticle     KnowledgeArticle?
  practiceUpdate       PracticeUpdate?
  practicePage         PracticePage?
  editorialItems       EditorialItem[]
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@unique([clinicId, path])
  @@index([clinicId, status])
  @@map("pages")
}

model PageRevision {
  id             String   @id @default(cuid())
  pageId         String   @map("page_id")
  html           String   @default("") @db.Text
  body           Json
  contentSha256  String   @map("content_sha256")
  authorId       String?  @map("author_id")
  immutable      Boolean  @default(false)
  page           Page     @relation("PageRevisions", fields: [pageId], references: [id], onDelete: Cascade)
  author         User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publishedFor   Page?    @relation("PublishedRevision")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([pageId])
  @@map("page_revisions")
}

model NavigationItem {
  id         String   @id @default(cuid())
  clinicId   String   @map("clinic_id")
  sectionKey String   @map("section_key")
  label      String
  href       String
  sortOrder  Int      @default(0) @map("sort_order")
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([clinicId, sectionKey])
  @@map("navigation_items")
}

model NavigationOwnership {
  id         String  @id @default(cuid())
  pageId     String  @unique @map("page_id")
  sectionKey String  @map("section_key")
  isHub      Boolean @default(false) @map("is_hub")
  breadcrumb Json
  page       Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("navigation_ownership")
}

model Practitioner {
  id                    String            @id @default(cuid())
  clinicId              String            @map("clinic_id")
  pageId                String?           @unique @map("page_id")
  slug                  String
  name                  String
  role                  String
  biography             String            @default("") @db.Text
  qualifications        String[]          @default([])
  languages             String[]          @default([])
  areasOfCare           String[]          @default([]) @map("areas_of_care")
  professionalInterests String[]          @default([]) @map("professional_interests")
  relatedServices       String[]          @default([]) @map("related_services")
  bookingUrl            String?           @map("booking_url")
  portraitPath          String?           @map("portrait_path")
  /** Patient-acquisition: show Accepting New Patients across directory/profile/search. */
  acceptingNewPatients  Boolean           @default(true) @map("accepting_new_patients")
  /** When set, "New to Woolloongabba Medical Centre" badge shows for 60 days from this instant. */
  newToPracticeAt       DateTime?         @map("new_to_practice_at")
  /** Admin availability signal — not live HotDoc. */
  availabilityStatus    String            @default("available_this_week") @map("availability_status")
  publishedPayload      Json?             @map("published_payload")
  status                PublicationStatus @default(planned)
  clinic                Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  page                  Page?             @relation(fields: [pageId], references: [id], onDelete: SetNull)
  gpStories             GpStory[]
  doctorProfileDrafts   GpDoctorProfileDraft[]
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  @@unique([clinicId, slug])
  @@index([clinicId, status])
  @@map("practitioners")
}

model Service {
  id                   String            @id @default(cuid())
  clinicId             String            @map("clinic_id")
  pageId               String?           @unique @map("page_id")
  slug                 String
  title                String
  summary              String            @default("") @db.Text
  patientEducation     Json?             @map("patient_education")
  whyItMatters         Json?             @map("why_it_matters")
  howWeHelp            Json?             @map("how_we_help")
  nextStep             Json?             @map("next_step")
  faqs                 Json?
  relatedPractitioners String[]          @default([]) @map("related_practitioners")
  relatedServices      String[]          @default([]) @map("related_services")
  publishedPayload     Json?             @map("published_payload")
  status               PublicationStatus @default(planned)
  contentOwner         String?           @map("content_owner")
  clinic               Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  page                 Page?             @relation(fields: [pageId], references: [id], onDelete: SetNull)
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  @@unique([clinicId, slug])
  @@index([clinicId, status])
  @@map("services")
}

model KnowledgeTopic {
  id        String            @id @default(cuid())
  clinicId  String            @map("clinic_id")
  pageId    String?           @unique @map("page_id")
  slug      String
  title            String
  summary          String            @default("") @db.Text
  publishedPayload Json?             @map("published_payload")
  status           PublicationStatus @default(planned)
  clinic           Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  page      Page?             @relation(fields: [pageId], references: [id], onDelete: SetNull)
  articles  KnowledgeArticle[]
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@unique([clinicId, slug])
  @@map("knowledge_topics")
}

model KnowledgeArticle {
  id                          String            @id @default(cuid())
  clinicId                    String            @map("clinic_id")
  pageId                      String?           @unique @map("page_id")
  topicId                     String?           @map("topic_id")
  slug                        String
  title                       String
  category                    String?
  summary                     String            @default("") @db.Text
  educationalContent          Json?             @map("educational_content")
  whenToSeekMedicalAdvice     Json?             @map("when_to_seek_medical_advice")
  howGpCanHelp                Json?             @map("how_gp_can_help")
  relatedServices             String[]          @default([]) @map("related_services")
  relatedPractitioners        String[]          @default([]) @map("related_practitioners")
  faqs                        Json?
  trustedSources              Json?             @map("trusted_sources")
  bookingCta                  Json?             @map("booking_cta")
  seo                         Json?
  publishedPayload            Json?             @map("published_payload")
  status                      PublicationStatus @default(planned)
  contentOwner                String?           @map("content_owner")
  dueDate                     DateTime?         @map("due_date")
  plannedPublicationDate      DateTime?         @map("planned_publication_date")
  publicationDate             DateTime?         @map("publication_date")
  nextReviewDate              DateTime?         @map("next_review_date")
  articlePath                 String?           @map("article_path")
  seoReviewComplete           Boolean           @default(false) @map("seo_review_complete")
  sourceVerificationComplete  Boolean           @default(false) @map("source_verification_complete")
  internalLinksVerified       Boolean           @default(false) @map("internal_links_verified")
  accessibilityReviewComplete Boolean           @default(false) @map("accessibility_review_complete")
  clinic                      Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  page                        Page?             @relation(fields: [pageId], references: [id], onDelete: SetNull)
  topic                       KnowledgeTopic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  createdAt                   DateTime          @default(now()) @map("created_at")
  updatedAt                   DateTime          @updatedAt @map("updated_at")

  @@unique([clinicId, slug])
  @@index([clinicId, status])
  @@map("knowledge_articles")
}

model PracticeUpdate {
  id           String            @id @default(cuid())
  clinicId     String            @map("clinic_id")
  pageId       String?           @unique @map("page_id")
  slug         String
  title        String
  category     UpdateCategory
  summary      String            @default("") @db.Text
  imagePath    String?           @map("image_path")
  imageAlt     String?           @map("image_alt")
  author       String?
  sections     Json?
  audience     String?
  publishedPayload Json?         @map("published_payload")
  status       PublicationStatus @default(planned)
  reviewStatus ReviewStatus      @default(draft) @map("review_status")
  clinic       Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  page         Page?             @relation(fields: [pageId], references: [id], onDelete: SetNull)
  publishedAt  DateTime?         @map("published_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@unique([clinicId, slug])
  @@index([clinicId, status])
  @@map("practice_updates")
}

model Faq {
  id          String            @id @default(cuid())
  clinicId    String            @map("clinic_id")
  category    String
  question    String            @db.Text
  answer      String            @db.Text
  relatedPage String?           @map("related_page")
  sortOrder   Int               @default(0) @map("sort_order")
  status      PublicationStatus @default(planned)
  clinic      Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([clinicId, category])
  @@map("faqs")
}

model Vacancy {
  id               String              @id @default(cuid())
  clinicId         String              @map("clinic_id")
  title            String
  status           VacancyStatus       @default(expression_of_interest)
  location         String              @default("")
  employmentType   String              @default("") @map("employment_type")
  roleCategory     VacancyRoleCategory @map("role_category")
  shortSummary     String              @default("") @map("short_summary") @db.Text
  fullDescription  String              @default("") @map("full_description") @db.Text
  remunerationNote String              @default("") @map("remuneration_note")
  offerHighlights  String[]            @default([]) @map("offer_highlights")
  requirements     String[]            @default([])
  applyUrl         String              @default("") @map("apply_url")
  featured         Boolean             @default(false)
  displayOrder     Int                 @default(0) @map("display_order")
  active           Boolean             @default(true)
  publishedAt      DateTime?           @map("published_at")
  expiresAt        DateTime?           @map("expires_at")
  clinic           Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  applications     CareerApplication[]
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([clinicId, active, featured, displayOrder])
  @@index([clinicId, status])
  @@map("vacancies")
}

model CareerApplication {
  id                 String                  @id @default(cuid())
  clinicId           String                  @map("clinic_id")
  vacancyId          String?                 @map("vacancy_id")
  name               String
  email              String
  phone              String                  @default("")
  roleInterest       String                  @map("role_interest")
  message            String                  @default("") @db.Text
  status             CareerApplicationStatus @default(new)
  notes              String                  @default("") @db.Text
  assignedToUserId   String?                 @map("assigned_to_user_id")
  resumeFileName     String?                 @map("resume_file_name")
  resumeStoragePath  String?                 @map("resume_storage_path")
  resumeMimeType     String?                 @map("resume_mime_type")
  resumeSizeBytes    Int?                    @map("resume_size_bytes")
  privacyConfirmedAt DateTime                @map("privacy_confirmed_at")
  source             String                  @default("talent_community")
  clinic             Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  vacancy            Vacancy?                @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  assignedTo         User?                   @relation("CareerApplicationAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  gpStories          GpStory[]
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  @@index([clinicId, status, createdAt])
  @@index([clinicId, vacancyId])
  @@index([clinicId, assignedToUserId])
  @@map("career_applications")
}

model PracticePage {
  id           String            @id @default(cuid())
  clinicId     String            @map("clinic_id")
  pageId       String?           @unique @map("page_id")
  slug         String
  title        String
  summary      String            @default("") @db.Text
  sections     Json?
  relatedPages String[]          @default([]) @map("related_pages")
  publishedPayload Json?         @map("published_payload")
  status       PublicationStatus @default(planned)
  contentOwner String?           @map("content_owner")
  clinic       Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  page         Page?             @relation(fields: [pageId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@unique([clinicId, slug])
  @@map("practice_pages")
}

model MediaAsset {
  id                  String             @id @default(cuid())
  clinicId            String             @map("clinic_id")
  filename            String
  storagePath         String             @map("storage_path")
  assetType           String             @map("asset_type")
  category            String?
  title               String?
  altText             String             @default("") @map("alt_text")
  uploadedBy          String?            @map("uploaded_by")
