model GpOnboardingCase {
  id                   String                 @id @default(cuid())
  clinicId             String                 @map("clinic_id")
  doctorDisplayName    String                 @map("doctor_display_name")
  doctorEmail          String?                @map("doctor_email")
  enquiryId            String?                @unique @map("enquiry_id")
  careerApplicationId  String?                @map("career_application_id")
  status               GpOnboardingCaseStatus @default(enquiry)
  currentStageId       GpOnboardingStageId    @default(initial_discussion) @map("current_stage_id")
  workflowVersion      String                 @default("1.0.0") @map("workflow_version")
  targetStartDate      DateTime?              @map("target_start_date")
  firstSessionAt       DateTime?              @map("first_session_at")
  dayOneSupportContact String?                @map("day_one_support_contact")
  providerNumberNote   String?                @map("provider_number_note")
  internalNotes        String?                @map("internal_notes") @db.Text
  clinic               Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  enquiry              GpEnquiry?             @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  stages               GpOnboardingStageState[]
  tasks                GpOnboardingTask[]
  gates                GpOnboardingGateEvent[]
  notifications        GpPipelineNotificationLog[]
  first90Case          GpFirst90SettlingCase?
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  @@index([clinicId, status])
  @@map("gp_onboarding_cases")
}

model GpOnboardingStageState {
  id             String                  @id @default(cuid())
  caseId         String                  @map("case_id")
  stageId        GpOnboardingStageId     @map("stage_id")
  status         GpOnboardingStageStatus @default(not_started)
  startedAt      DateTime?               @map("started_at")
  readyForGateAt DateTime?               @map("ready_for_gate_at")
  gateApprovedAt DateTime?               @map("gate_approved_at")
  externalAgency String?                 @map("external_agency")
  blockerSummary String?                 @map("blocker_summary")
  case           GpOnboardingCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  updatedAt      DateTime                @updatedAt @map("updated_at")

  @@unique([caseId, stageId])
  @@index([status])
  @@map("gp_onboarding_stage_states")
}

model GpOnboardingTask {
  id          String                 @id @default(cuid())
  caseId      String                 @map("case_id")
  stageId     GpOnboardingStageId    @map("stage_id")
  taskKey     String                 @map("task_key")
  owner       GpOnboardingTaskOwner
  label       String
  required    Boolean                @default(true)
  status      GpOnboardingTaskStatus @default(pending)
  completedAt DateTime?              @map("completed_at")
  completedBy String?                @map("completed_by")
  notes       String?
  case        GpOnboardingCase       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  updatedAt   DateTime               @updatedAt @map("updated_at")

  @@unique([caseId, taskKey])
  @@index([caseId, stageId, status])
  @@map("gp_onboarding_tasks")
}

model GpOnboardingGateEvent {
  id                String                   @id @default(cuid())
  caseId            String                   @map("case_id")
  stageId           GpOnboardingStageId      @map("stage_id")
  decision          GpOnboardingGateDecision
  reviewerId        String                   @map("reviewer_id")
  reviewerName      String                   @map("reviewer_name")
  rationale         String                   @db.Text
  checklistSnapshot Json?                    @map("checklist_snapshot")
  case              GpOnboardingCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reviewer          User                     @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  createdAt         DateTime                 @default(now()) @map("created_at")

  @@index([caseId, stageId, createdAt])
  @@map("gp_onboarding_gate_events")
}

/// First 90 Days settling — extends onboarding after Stage 7 Go-live.
model GpFirst90SettlingCase {
  id                String              @id @default(cuid())
  clinicId          String              @map("clinic_id")
  onboardingCaseId  String              @unique @map("onboarding_case_id")
  doctorDisplayName String              @map("doctor_display_name")
  status            GpFirst90CaseStatus @default(active)
  currentPhase      GpFirst90Phase      @default(day1) @map("current_phase")
  goLiveAt          DateTime            @map("go_live_at")
  reviewDueAt       DateTime?           @map("review_due_at")
  closedAt          DateTime?           @map("closed_at")
  closeSummary      String?             @map("close_summary") @db.Text
  clinic            Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  onboardingCase    GpOnboardingCase    @relation(fields: [onboardingCaseId], references: [id], onDelete: Cascade)
  checklistItems    GpFirst90ChecklistItem[]
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([clinicId, status])
  @@map("gp_first90_settling_cases")
}

model GpFirst90ChecklistItem {
  id          String              @id @default(cuid())
  caseId      String              @map("case_id")
  itemKey     String              @map("item_key")
  phase       GpFirst90Phase
  owner       String
  theme       String
  label       String
  done        Boolean             @default(false)
  doneAt      DateTime?           @map("done_at")
  doneBy      String?             @map("done_by")
  notes       String?
  case        GpFirst90SettlingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@unique([caseId, itemKey])
  @@index([caseId, phase, done])
  @@map("gp_first90_checklist_items")
}

/// Shared notification log for pipeline events (onboarding catalog + enquiry events).
model GpPipelineNotificationLog {
  id               String            @id @default(cuid())
  clinicId         String            @map("clinic_id")
  eventId          String            @map("event_id")
  channel          String            @default("in_app")
  recipientRole    String            @map("recipient_role")
  payload          Json
  enquiryId        String?           @map("enquiry_id")
  onboardingCaseId String?           @map("onboarding_case_id")
  /// Explicit: notification ack is never an approval
  countsAsApproval Boolean           @default(false) @map("counts_as_approval")
  enquiry          GpEnquiry?        @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  onboardingCase   GpOnboardingCase? @relation(fields: [onboardingCaseId], references: [id], onDelete: SetNull)
  sentAt           DateTime          @default(now()) @map("sent_at")

  @@index([clinicId, sentAt])
  @@index([enquiryId])
  @@index([onboardingCaseId])
  @@map("gp_pipeline_notification_logs")
}

// ---------------------------------------------------------------------------
// GP Attraction Analytics — proposal event model (no automated decisions)
// ---------------------------------------------------------------------------

enum GpAttractionSurface {
  gp_opportunities
  gp_faq
  doctor_readiness
  provider_number_readiness
  gp_session_planner
  gp_eoi
  dpa_19ab_navigator
  practice_support_matrix
  join_our_team
  practice_experience
  opportunity_pack
}

enum GpAttractionPersonaHint {
  early_career_gp
  established_gp_seeking_change
  returning_gp
  part_time_parent_gp
  special_interest_gp
  unknown
}

enum GpAttractionChannel {
  direct
  organic_search
  referral
  email
  social
  unknown
}

model GpAttractionEvent {
  id                 String                  @id @default(cuid())
  clinicId           String                  @map("clinic_id")
  occurredAt         DateTime                @default(now()) @map("occurred_at")
  name               String
  anonymousSessionId String                  @map("anonymous_session_id")
  surface            GpAttractionSurface?
  toolId             String?                 @map("tool_id")
  path               String?
  referrerPath       String?                 @map("referrer_path")
  faqId              String?                 @map("faq_id")
  ctaId              String?                 @map("cta_id")
  stepId             String?                 @map("step_id")
  stepIndex          Int?                    @map("step_index")
  lastStepId         String?                 @map("last_step_id")
  fromSurface        GpAttractionSurface?    @map("from_surface")
  toSurface          GpAttractionSurface?    @map("to_surface")
  vote               String?
  eoiSubmissionId    String?                 @map("eoi_submission_id")
  moduleId           String?                 @map("module_id")
  packId             String?                 @map("pack_id")
  personaHint        GpAttractionPersonaHint @default(unknown) @map("persona_hint")
  channel            GpAttractionChannel     @default(unknown)
  deviceClass        String?                 @map("device_class")
  durationMs         Int?                    @map("duration_ms")
  props              Json?
  clinic             Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt          DateTime                @default(now()) @map("created_at")

  @@index([clinicId, occurredAt])
  @@index([clinicId, name, occurredAt])
  @@index([anonymousSessionId, occurredAt])
  @@index([toolId, name])
  @@index([personaHint, occurredAt])
  @@map("gp_attraction_events")
}

model GpAttractionDailyRollup {
  id        String   @id @default(cuid())
  clinicId  String   @map("clinic_id")
  day       DateTime @db.Date
  metricId  String   @map("metric_id")
  dimension String   @default("_all")
  value     Float
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clinicId, day, metricId, dimension])
  @@index([clinicId, day])
  @@map("gp_attraction_daily_rollups")
}

model GpAttractionPathRollup {
  id          String   @id @default(cuid())
  clinicId    String   @map("clinic_id")
  windowDays  Int      @map("window_days")
  pathKey     String   @map("path_key")
  sessions    Int
  eoiSessions Int      @map("eoi_sessions")
  liftToEoi   Float?   @map("lift_to_eoi")
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([clinicId, windowDays, pathKey])
  @@map("gp_attraction_path_rollups")
}

model ContentIntelligenceSignalDaily {
  id        String   @id @default(cuid())
  clinicId  String   @map("clinic_id")
  day       DateTime @db.Date
  source    String
  key       String
  value     Float
  metaJson  Json?    @map("meta_json")
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([clinicId, day, source, key])
  @@index([clinicId, source, day])
  @@map("content_intelligence_signal_daily")
}

model ContentIntelligenceInsightRun {
  id                   String   @id @default(cuid())
  clinicId             String   @map("clinic_id")
  periodLabel          String   @map("period_label")
  windowDays           Int      @default(28) @map("window_days")
  generatedAt          DateTime @default(now()) @map("generated_at")
  gapsJson             Json     @map("gaps_json")
  unansweredJson       Json     @map("unanswered_json")
  highConvertingJson   Json     @map("high_converting_json")
  monthlyRecsJson      Json     @map("monthly_recs_json")
  seoOpportunitiesJson Json     @map("seo_opportunities_json")
  doctorInfoGapsJson   Json     @map("doctor_info_gaps_json")
  brandAlignmentJson   Json     @map("brand_alignment_json")
  createdByUserId      String?  @map("created_by_user_id")
  clinic               Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, generatedAt])
  @@map("content_intelligence_insight_runs")
}

/// Snapshot of knowledge-graph nodes/edges derived from analytics (advisory).
model AttractionKnowledgeGraphSnapshot {
  id          String   @id @default(cuid())
  clinicId    String   @map("clinic_id")
  windowDays  Int      @map("window_days")
  generatedAt DateTime @default(now()) @map("generated_at")
  nodesJson   Json     @map("nodes_json")
  edgesJson   Json     @map("edges_json")
  summaryJson Json?    @map("summary_json")
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, generatedAt])
  @@map("attraction_knowledge_graph_snapshots")
}

/// Server-only private blobs (CVs, GP readiness docs). Not exposed via Data API.
/// Used when PRIVATE_OBJECT_STORE=postgres so Hostinger redeploys do not wipe files.
model PrivateObject {
  id         String   @id @default(cuid())
  clinicId   String   @map("clinic_id")
  purpose    String
  objectKey  String   @unique @map("object_key")
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  bytes      Bytes
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([clinicId, purpose, createdAt])
  @@map("private_objects")
}
