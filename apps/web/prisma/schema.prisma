// ---------------------------------------------------------------------------
// GP Attraction CMS — Phase 1
// Human approvals only; immutable revisions; production publish blocked in services.
// Domains: opportunities, faq, practice_experience, registrar_pathway, story
// ---------------------------------------------------------------------------

enum AttractionDocumentKind {
  opportunities
  faq
  practice_experience
  registrar_pathway
  story
  catchment_analysis
  continuity_network
  clinical_interests
}

enum AttractionPublishState {
  drafting
  in_review
  approved
  scheduled
  published
  review_due
  on_hold
  archived
}

enum AttractionChangeClass {
  A_minor
  B_substantive_copy
  C_clinical_or_capacity
  D_schema_or_vacancy
}

enum AttractionApprovalDecision {
  submit_for_review
  request_changes
  approve
  pause
  archive
  /// Recorded intent only in Phase 1 — services refuse production publish.
  approve_publish_intent
}

enum AttractionAssetKind {
  image
  video
  transcript
  quote
  testimonial_ref
  consent_document
  other
}

enum AttractionAssetStatus {
  captured
  catalogued
  in_review
  approved
  published
  review_due
  retired
  withdrawn
  purged
}

enum AttractionAssetReviewDecision {
  submit_for_review
  request_changes
  approve
  publish
  mark_review_due
  retire
  withdraw
  purge
  replace_placeholder
}

enum AttractionAssetRightsClass {
  no_people
  consented_staff
  consented_gp_named
  role_label_only
  composite_labelled
  ai_placeholder
}

/// Clinic-scoped attraction content unit (section, FAQ set, hub, pathway, story).
model AttractionDocument {
  id                   String                 @id @default(cuid())
  clinicId             String                 @map("clinic_id")
  kind                 AttractionDocumentKind
  /// Stable slug within clinic+kind (e.g. hub, gp-faq, typical-day, registrar-pathway, story-demo-001)
  slug                 String
  title                String
  summary              String                 @default("") @db.Text
  publishState         AttractionPublishState @default(drafting) @map("publish_state")
  changeClassDefault   AttractionChangeClass  @default(B_substantive_copy) @map("change_class_default")
  /// Public surface path when applicable (e.g. about-us/practice-experience.html)
  surfacePath          String?                @map("surface_path")
  /// Schema rule set key from attraction schema-rules.json
  schemaRuleSetKey     String                 @map("schema_rule_set_key")
  publishedRevisionId  String?                @unique @map("published_revision_id")
  /// Optional story-capture case id (external until GpStory migrates)
  storyCaptureRef      String?                @map("story_capture_ref")
  /// Working body draft (mutable). Published body lives only on AttractionRevision.
  draftBody            Json                   @map("draft_body")
  clinic               Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  publishedRevision    AttractionRevision?    @relation("AttractionPublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: SetNull)
  revisions            AttractionRevision[]   @relation("AttractionDocumentRevisions")
  approvalEvents       AttractionApprovalEvent[]
  schemaValidations    AttractionSchemaValidation[]
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  @@unique([clinicId, kind, slug])
  @@index([clinicId, publishState])
  @@index([clinicId, kind])
  @@map("attraction_documents")
}

/// Append-only immutable revision — mirrors PageRevision semantics.
model AttractionRevision {
  id             String             @id @default(cuid())
  documentId     String             @map("document_id")
  versionNumber  Int                @map("version_number")
  body           Json
  contentSha256  String             @map("content_sha256")
  changeClass    AttractionChangeClass @map("change_class")
  authorId       String?            @map("author_id")
  immutable      Boolean            @default(true)
  note           String             @default("")
  document       AttractionDocument @relation("AttractionDocumentRevisions", fields: [documentId], references: [id], onDelete: Cascade)
  author         User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publishedFor   AttractionDocument? @relation("AttractionPublishedRevision")
  approvalEvents AttractionApprovalEvent[]
  schemaValidations AttractionSchemaValidation[]
  createdAt      DateTime           @default(now()) @map("created_at")

  @@unique([documentId, versionNumber])
  @@index([documentId, createdAt])
  @@index([contentSha256])
  @@map("attraction_revisions")
}

/// Immutable human gate — reviewerId required; never system/auto.
model AttractionApprovalEvent {
  id                    String                     @id @default(cuid())
  documentId            String                     @map("document_id")
  revisionId            String                     @map("revision_id")
  fromState             AttractionPublishState     @map("from_state")
  toState               AttractionPublishState     @map("to_state")
  decision              AttractionApprovalDecision
  changeClass           AttractionChangeClass      @map("change_class")
  reviewerId            String                     @map("reviewer_id")
  reviewerName          String                     @map("reviewer_name")
  reviewerRole          String                     @map("reviewer_role")
  rationale             String                     @db.Text
  checklistSnapshot     Json?                      @map("checklist_snapshot")
  reviewedContentSha256 String                     @map("reviewed_content_sha256")
  document              AttractionDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revision              AttractionRevision         @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  reviewer              User                       @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  createdAt             DateTime                   @default(now()) @map("created_at")

  @@index([documentId, createdAt])
  @@index([revisionId])
  @@index([decision])
  @@map("attraction_approval_events")
}

/// Schema validation hook result attached to a revision (fail-closed before publish).
model AttractionSchemaValidation {
  id             String             @id @default(cuid())
  documentId     String             @map("document_id")
  revisionId     String             @map("revision_id")
  ruleSetKey     String             @map("rule_set_key")
  passed         Boolean
  violations     Json               @default("[]")
  checkedAt      DateTime           @default(now()) @map("checked_at")
  document       AttractionDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revision       AttractionRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([documentId, revisionId])
  @@index([passed])
  @@map("attraction_schema_validations")
}

/// GP Attraction Asset Library — registry for images, video, transcripts, quotes.
/// AI placeholders allowed; replaceablePath points at future consented masters.
model AttractionAsset {
  id                   String                     @id @default(cuid())
  clinicId             String                     @map("clinic_id")
  assetId              String                     @map("asset_id")
  kind                 AttractionAssetKind
  status               AttractionAssetStatus      @default(captured)
  title                String                     @default("")
  /// Public or object-store path for current deliverable (may be AI placeholder).
  storagePath          String?                    @map("storage_path")
  /// Future consented master path — swap without changing assetId.
  replaceablePath      String?                    @map("replaceable_path")
  placeholderKind      String?                    @map("placeholder_kind") /// ai | none | pending_shoot
  mime                 String?
  width                Int?
  height               Int?
  durationSec          Int?                       @map("duration_sec")
  byteSize             Int?                       @map("byte_size")
  contentSha256        String?                    @map("content_sha256")
  altText              String                     @default("") @map("alt_text")
  caption              String                     @default("")
  quoteText            String?                    @map("quote_text") @db.Text
  derivativesJson      Json?                      @map("derivatives_json")
  taxonomyTags         String[]                   @default([]) @map("taxonomy_tags")
  scene                String?
  surfaceHints         String[]                   @default([]) @map("surface_hints")
  moduleHints          String[]                   @default([]) @map("module_hints")
  personaHints         String[]                   @default([]) @map("persona_hints")
  rightsClass          AttractionAssetRightsClass @default(ai_placeholder) @map("rights_class")
  aiPolicy             String                     @default("ai_ok") @map("ai_policy")
  clinicScope          String                     @default("flagship_only") @map("clinic_scope")
  channelsAllowedJson  Json                       @default("[]") @map("channels_allowed_json")
  channelsDeniedJson   Json                       @default("[]") @map("channels_denied_json")
  /// Legacy string refs kept for Phase 1 rows
  consentRef           String?                    @map("consent_ref")
  relatedStoryRef      String?                    @map("related_story_ref")
  sourceShotId         String?                    @map("source_shot_id")
  relatedDocumentKind  String?                    @map("related_document_kind")
  transcriptOfAssetId  String?                    @map("transcript_of_asset_id")
  parentAssetId        String?                    @map("parent_asset_id")
  relatedStoryId       String?                    @map("related_story_id")
  consentRecordId      String?                    @map("consent_record_id")
  reviewCadenceDays    Int                        @default(730) @map("review_cadence_days")
  lastReviewedAt       DateTime?                  @map("last_reviewed_at")
  nextReviewAt         DateTime?                  @map("next_review_at")
  withdrawnAt          DateTime?                  @map("withdrawn_at")
  ownerUserId          String?                    @map("owner_user_id")
  clinic               Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  relatedStory         GpStory?                   @relation(fields: [relatedStoryId], references: [id], onDelete: SetNull)
  consentRecord        AttractionAssetConsent?    @relation(fields: [consentRecordId], references: [id], onDelete: SetNull)
  reviewEvents         AttractionAssetReviewEvent[]
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  @@unique([clinicId, assetId])
  @@index([clinicId, status])
  @@index([clinicId, kind])
  @@index([relatedStoryId])
  @@index([nextReviewAt])
  @@map("attraction_assets")
}

/// Versioned media consent for identifiable people in assets.
model AttractionAssetConsent {
  id                  String    @id @default(cuid())
  clinicId            String    @map("clinic_id")
  consentVersion      String    @map("consent_version")
  subjectDisplayName  String    @map("subject_display_name")
  status              String    @default("draft") /// draft | signed | withdrawn | expired | superseded
  channelsAllowedJson Json      @default("[]") @map("channels_allowed_json")
  channelsDeniedJson  Json      @default("[]") @map("channels_denied_json")
  documentUri         String?   @map("document_uri")
  signedAt            DateTime? @map("signed_at")
  signedByName        String?   @map("signed_by_name")
  withdrawnAt         DateTime? @map("withdrawn_at")
  withdrawalReason    String?   @map("withdrawal_reason") @db.Text
  retentionUntil      DateTime? @map("retention_until")
  relatedStoryId      String?   @map("related_story_id")
  notes               String?   @db.Text
  assets              AttractionAsset[]
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([clinicId, status])
  @@index([relatedStoryId])
  @@map("attraction_asset_consents")
}

/// Immutable human review / lifecycle events for assets.
model AttractionAssetReviewEvent {
  id           String                        @id @default(cuid())
  assetId      String                        @map("asset_row_id")
  fromStatus   AttractionAssetStatus         @map("from_status")
  toStatus     AttractionAssetStatus         @map("to_status")
  decision     AttractionAssetReviewDecision
  reviewerId   String                        @map("reviewer_id")
  reviewerName String                        @map("reviewer_name")
  rationale    String                        @db.Text
  checklistJson Json?                        @map("checklist_json")
  asset        AttractionAsset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reviewer     User                          @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  createdAt    DateTime                      @default(now()) @map("created_at")

  @@index([assetId, createdAt])
  @@index([decision])
  @@map("attraction_asset_review_events")
}

