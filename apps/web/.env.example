# PostgreSQL connection used by Prisma and the Next.js server.
DATABASE_URL=postgresql://wmc:wmc@localhost:5432/wmc?schema=public

# Auth.js secret. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# Public origin of this app. Leave unset for local development so staff sign-in
# works on localhost and on this computer's LAN address. Set it in production.
# AUTH_URL=https://gabbamedicalcentre.com.au

# Required behind Nginx on the VPS. Cloudflare SSL/TLS mode is Full (strict).
AUTH_TRUST_HOST=true

# Clinic slug used for localhost, 127.0.0.1, and private LAN addresses during development.
DEFAULT_CLINIC_SLUG=woolloongabba

# Optional first Super Admin. Leave the username blank to skip creating a user during seed.
# Sign-in uses the username and password. There is no public registration.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=

# Optional inbox for patient form requests. The API stores the request either way.
FORM_REQUEST_NOTIFY_EMAIL=

# Directory of the approved HTML when importing inside Docker. Leave unset for a local checkout.
# GOLDEN_HTML_ROOT=/golden
