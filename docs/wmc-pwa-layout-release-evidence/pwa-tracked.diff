+transform:scaleX(0);transform-origin:0 50%;z-index:9999;pointer-events:none}
+body.pwa-nav-loading .patient-pwa-nav-progress{transform:scaleX(.72);transition:transform 6s cubic-bezier(.1,.6,.2,1)}
